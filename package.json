{
  "name": "matte",
  "version": "1.0.0",
  "description": "MatteJ",
  "main": "matteWebAce.js",
  "type": "module",
  "scripts": {
    "test": "jest",
    "antlr": "java -jar antlr-4.13.2-complete.jar -visitor -o ./src/generated -Dlanguage=TypeScript ./JavaGrammar.g4",
    "lib": "esbuild src/Interpreter.ts --bundle --outfile=dist/matte.js --format=esm --platform=browser --sourcemap --minify",
    "ace": "npx esbuild matteWebAce.js --bundle --minify --outfile=dist/matte-web-ace.js",
    "build": "npm run antlr && npm run lib && npm run ace"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ace-builds": "^1.45.2",
    "antlr4": "^4.13.2",
    "antlr4ts": "^0.5.0-alpha.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "assert": "^2.1.0",
    "esbuild": "0.27.7",
    "jest": "^30.4.2",
    "mocha": "^11.7.5",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
